# Install as /etc/scamshield/scamshield.env (root:scamshield-runtime, mode 0640).
# Quote values containing spaces or shell metacharacters because the one-time
# authorization helper sources this root-owned file.

SCAMSHIELD_TOKEN=
SCAMSHIELD_OWNER_ID=

# Attach the raw lane to monitor.py's authenticated user session. This is the
# correct mode for third-party public sources; keep scamshield-dragon-den
# disabled because it is the alternative standalone Bot API poller.
DRAGON_DEN_RELAY_ENABLED=0
# Dedicated @BotFather identity for warnings and channel identity. It must not
# reuse SCAMSHIELD_TOKEN.
DRAGON_DEN_BOT_TOKEN=
DRAGON_DEN_ROUTES_FILE=/etc/scamshield/dragon-den-routes.json
DRAGON_DEN_DB=/var/lib/scamshield/dragon-den/dragon-den.db
# Protect Bot API notices. Also enable Telegram's Restrict Saving Content on
# every destination so protection applies to native Telethon forwards too.
DRAGON_DEN_PROTECT_CONTENT=1

# One-time Telethon application/account setup. The resulting user session is
# kept in /var/lib/scamshield and survives every code release.
TELETHON_API_ID=
TELETHON_API_HASH=
# Optional. Leave blank to enter it only in the one-time SSH authorization.
SCAMSHIELD_PHONE=

# Generate once, for example: openssl rand -hex 32
SCAMSHIELD_PSEUDONYM_KEY=

SCAMSHIELD_DB=/var/lib/scamshield/scamshield.db
SCAMSHIELD_SESSION=/var/lib/scamshield/telegram/scamshield_monitor
SCAMSHIELD_CHANNELS_FILE=/etc/scamshield/channels.txt
SCAMSHIELD_STORE_RAW_SAMPLES=0
SCAMSHIELD_GUARDIAN=0
SCAMSHIELD_FORCE_IPV4=1
SCAMSHIELD_PALIMPSEST_ROOT=/opt/palimpsest/current
SCAMSHIELD_PALIMPSEST_OUTBOX=var/scamshield-inbox
SCAMSHIELD_SHARE_MIN_TIER=WATCH

# Optional metadata-link-only Palimpsest social-observation lane. Collection
# occurs only when a public publisher is active in this reviewed registry AND
# the same @handle is present in SCAMSHIELD_CHANNELS_FILE. Numeric peer IDs and
# standalone native identity fields stay private; the public post number appears
# only inside the canonical t.me permalink. Raw messages and media are not kept.
SCAMSHIELD_SOCIAL_OBSERVATIONS_ENABLED=0
SCAMSHIELD_SOCIAL_SOURCES_FILE=/etc/scamshield/palimpsest-social-sources.json
# Production paths are fixed: the private database is under
# /var/lib/scamshield/social (scamshield:scamshield-social 2750; DB 0640), and
# only sanitized bundles are written by the dedicated exporter to
# /var/lib/scamshield/social-export (scamshield-social-export:caddy 2750). The
# signing secret is the root-only systemd credential
# /etc/scamshield/social-export-hmac.key.
SCAMSHIELD_SOCIAL_MAX_STALENESS_SECONDS=900

# Private aggregate handoff gate for Palimpsest/NarcoScope analyst review.
SCAMSHIELD_EXPORT_MIN_MESSAGES=20
SCAMSHIELD_EXPORT_MIN_SOURCES=2

# Durable monitor recovery and source refresh. History is text/caption only;
# media is never downloaded by this collector.
SCAMSHIELD_INITIAL_HISTORY=100
SCAMSHIELD_BACKFILL_BATCH=250
SCAMSHIELD_RECONCILE_SECONDS=300
SCAMSHIELD_RECONCILE_CONCURRENCY=4
SCAMSHIELD_SOURCE_REFRESH_SECONDS=60
SCAMSHIELD_CANDIDATE_VERIFY_SECONDS=300
SCAMSHIELD_CLAIM_LEASE_SECONDS=900
SCAMSHIELD_ANALYSIS_CONCURRENCY=4
SCAMSHIELD_LIVE_WORKERS=8
SCAMSHIELD_LIVE_QUEUE_SIZE=1000
SCAMSHIELD_FLOOD_SLEEP_THRESHOLD=60
SCAMSHIELD_AUTO_JOIN_PUBLIC=1
SCAMSHIELD_DISCOVERY_VERIFY_ENABLED=1
SCAMSHIELD_DISCOVERY_VERIFY_BATCH=20
SCAMSHIELD_DISCOVERY_VERIFY_MIN_HITS=1
SCAMSHIELD_DISCOVERY_VERIFY_MIN_SOURCES=1
SCAMSHIELD_DISCOVERY_RECHECK_SECONDS=86400
SCAMSHIELD_DISCOVERY_RETRY_SECONDS=3600

# Optional live-rate provider credential.
COINGECKO_DEMO_API_KEY=
