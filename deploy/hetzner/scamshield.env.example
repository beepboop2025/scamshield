# Install as /etc/scamshield/scamshield.env (root:scamshield-runtime, mode 0640).
# Quote values containing spaces or shell metacharacters because the one-time
# authorization helper sources this root-owned file.

SCAMSHIELD_TOKEN=
SCAMSHIELD_OWNER_ID=

# One-time Telethon application/account setup. The resulting user session is
# kept in /var/lib/scamshield and survives every code release.
TELETHON_API_ID=
TELETHON_API_HASH=
# Optional. Leave blank to enter it only in the one-time SSH authorization.
SCAMSHIELD_PHONE=

# Generate once, for example: openssl rand -hex 32
SCAMSHIELD_PSEUDONYM_KEY=

SCAMSHIELD_DB=/var/lib/scamshield/scamshield.db
SCAMSHIELD_SESSION=/var/lib/scamshield/telegram/scamshield_monitor
SCAMSHIELD_CHANNELS_FILE=/etc/scamshield/channels.txt
SCAMSHIELD_STORE_RAW_SAMPLES=0
SCAMSHIELD_GUARDIAN=0
SCAMSHIELD_FORCE_IPV4=1
SCAMSHIELD_PALIMPSEST_ROOT=/opt/palimpsest/current
SCAMSHIELD_PALIMPSEST_OUTBOX=var/scamshield-inbox
SCAMSHIELD_SHARE_MIN_TIER=WATCH

# Private aggregate handoff gate for Palimpsest/NarcoScope analyst review.
SCAMSHIELD_EXPORT_MIN_MESSAGES=20
SCAMSHIELD_EXPORT_MIN_SOURCES=2

# Durable monitor recovery and source refresh. History is text/caption only;
# media is never downloaded by this collector.
SCAMSHIELD_INITIAL_HISTORY=100
SCAMSHIELD_BACKFILL_BATCH=250
SCAMSHIELD_RECONCILE_SECONDS=300
SCAMSHIELD_CLAIM_LEASE_SECONDS=900
SCAMSHIELD_ANALYSIS_CONCURRENCY=4
SCAMSHIELD_FLOOD_SLEEP_THRESHOLD=60
SCAMSHIELD_AUTO_JOIN_PUBLIC=1

# Optional live-rate provider credential.
COINGECKO_DEMO_API_KEY=
