[Unit]
Description=Build ScamShield privacy-minimized downstream review artifacts
After=scamshield-bot.service scamshield-monitor.service

[Service]
Type=oneshot
User=scamshield
Group=scamshield-runtime
SupplementaryGroups=scamshield intelligence-review
WorkingDirectory=/opt/scamshield/current
Environment=SCAMSHIELD_DB=/var/lib/scamshield/scamshield.db
Environment=SCAMSHIELD_EXPORT_MIN_MESSAGES=20
Environment=SCAMSHIELD_EXPORT_MIN_SOURCES=2
UMask=0077
ExecStart=/opt/scamshield/current/deploy/hetzner/render_review_feed.sh
PrivateNetwork=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
ReadOnlyPaths=/opt/scamshield /opt/palimpsest /var/lib/scamshield/palimpsest-inbox
ReadWritePaths=/var/lib/scamshield/review /var/lib/scamshield/handoffs/narcoscope
InaccessiblePaths=/var/lib/scamshield/social-export
BindReadOnlyPaths=/var/lib/scamshield/palimpsest-inbox:/opt/palimpsest/current/var/scamshield-inbox
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
