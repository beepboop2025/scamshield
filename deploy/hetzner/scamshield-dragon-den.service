[Unit]
Description=Whispers from the Dragon Den raw Telegram mirror
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/scamshield/dragon-den-routes.json
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=scamshield
Group=scamshield-runtime
WorkingDirectory=/opt/scamshield/current
EnvironmentFile=/etc/scamshield/scamshield.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
ExecStartPre=/opt/scamshield/current/deploy/hetzner/preflight.sh dragon-den
ExecStart=/opt/scamshield/current/.venv/bin/python /opt/scamshield/current/dragon_den_bot.py
Restart=always
RestartSec=10
TimeoutStopSec=30

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadOnlyPaths=/opt/scamshield /opt/palimpsest /etc/scamshield
ReadWritePaths=/var/lib/scamshield/dragon-den /var/lib/scamshield/palimpsest-inbox
InaccessiblePaths=/var/lib/scamshield/social-export
BindPaths=/var/lib/scamshield/palimpsest-inbox:/opt/palimpsest/current/var/scamshield-inbox
MemoryMax=768M
TasksMax=128
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
